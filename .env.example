# Which AI writes the drafts: "claude" (needs an Anthropic API key) or "local" (free, runs on your computer).
AI_PROVIDER=claude

# For AI_PROVIDER=claude. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# For AI_PROVIDER=local. These defaults work with Ollama out of the box.
LOCAL_AI_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3.1:8b
# Only needed if your local AI server asks for a key (Open WebUI does).
LOCAL_AI_API_KEY=

# Port the app runs on. Change it if another program already uses this one.
PORT=3005
