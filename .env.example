# You can leave this whole file as it is and pick the model on the app's Model settings page instead.

# Which AI the server drafts with: "claude" or "local". Only used when the Model settings page is set to
# Claude with no key entered there.
AI_PROVIDER=claude

# Optional. Get a key at https://console.anthropic.com/settings/keys. A key entered on the Model settings
# page is used instead and never reaches the server.
ANTHROPIC_API_KEY=

# For AI_PROVIDER=local. These defaults work with Ollama; for LM Studio use http://localhost:1234/v1
# and the model identifier shown in its Developer tab.
LOCAL_AI_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3.1:8b
# Only needed if your local AI server asks for a key (Open WebUI does).
LOCAL_AI_API_KEY=

# Port the app runs on. Change it if another program already uses this one.
PORT=3005
